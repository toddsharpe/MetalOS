---
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Always
ColumnLimit: 120

# Allman braces — opening brace on its own line everywhere
BreakBeforeBraces: Allman

# Access specifiers (public/private/protected) at column 0, not indented
AccessModifierOffset: -4

# Namespace body is indented
NamespaceIndentation: All

# Pointer attached to variable name: uint8_t *ptr
PointerAlignment: Right

# Constructor initializer list: colon at end of declaration line, each
# initializer on its own line
BreakConstructorInitializers: AfterColon
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4

# No collapsing short functions onto a single line
AllowShortFunctionsOnASingleLine: None

# template <size_t N> on its own line before the class declaration
AlwaysBreakTemplateDeclarations: Yes

# Space between 'template' keyword and '<'
SpaceAfterTemplateKeyword: true
