<?xml version="1.0" encoding="utf-8"?>
<!-- Shared build settings: each .vcxproj sets MetalOSKind (Kernel, Boot, User or Host) and ConfigurationType, imports this, lists its sources, then imports MetalOS.targets -->
<!-- Debug is unoptimized; Release is /O2 with LTCG -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <MetalOSSrc>$(MSBuildThisFileDirectory)</MetalOSSrc>
    <MetalOSRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</MetalOSRoot>
    <MetalOSLtcg Condition="'$(MetalOSLtcg)' == '' and '$(Configuration)' == 'Release' and '$(MetalOSKind)' != 'Kernel'">true</MetalOSLtcg>
    <MetalOSLtcg Condition="'$(MetalOSLtcg)' == ''">false</MetalOSLtcg>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>$(MetalOSLtcg)</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>

  <!-- Every binary lands in build\ for make_vhd; objects go per project, and every build is a full rebuild -->
  <PropertyGroup>
    <OutDir>$(MetalOSRoot)build\</OutDir>
    <IntDir>$(MetalOSRoot)build\obj\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
    <GenerateManifest>false</GenerateManifest>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>Default</LanguageStandard_C>
      <Optimization>Disabled</Optimization>
      <WholeProgramOptimization>$(MetalOSLtcg)</WholeProgramOptimization>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <StringPooling>true</StringPooling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <ExceptionHandling>false</ExceptionHandling>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SDLCheck>false</SDLCheck>
      <SupportJustMyCode>false</SupportJustMyCode>
      <ConformanceMode>Default</ConformanceMode>
      <WarningLevel>Level3</WarningLevel>
      <!-- C4200: zero-sized trailing arrays, the idiom of the on-disk and hardware structs here and in the Windows headers -->
      <DisableSpecificWarnings>4200;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>/Gw %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(MetalOSSrc);$(MetalOSRoot)external</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration Condition="'$(MetalOSLtcg)' == 'true'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGeneration Condition="'$(MetalOSLtcg)' != 'true'">Default</LinkTimeCodeGeneration>
      <TargetMachine>MachineX64</TargetMachine>
      <DataExecutionPrevention></DataExecutionPrevention>
      <ProgramDatabaseFile>$(OutDir)$(TargetName).pdb</ProgramDatabaseFile>
    </Link>
    <Lib>
      <LinkTimeCodeGeneration>$(MetalOSLtcg)</LinkTimeCodeGeneration>
    </Lib>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Kernel, boot loader and user mode: no standard headers or libraries, only src\std and core_crt -->
  <!-- No stack probes (/Gs): stacks are committed up front, with no guard pages to touch and no __chkstk to call -->
  <ItemDefinitionGroup Condition="'$(MetalOSKind)' != 'Host'">
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) /Gs2147483647</AdditionalOptions>
      <IgnoreStandardIncludePath>true</IgnoreStandardIncludePath>
      <OmitDefaultLibName>true</OmitDefaultLibName>
      <AdditionalIncludeDirectories>$(MetalOSSrc);$(MetalOSRoot)external;$(MetalOSSrc)std</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <AdditionalDependencies></AdditionalDependencies>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
    </Link>
  </ItemDefinitionGroup>

  <!-- Kernel mode is never optimized: optimized MSVC x64 code copies and zeroes structs through XMM registers, which the kernel doesn't save -->
  <ItemDefinitionGroup Condition="'$(MetalOSKind)' == 'Kernel'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <IntrinsicFunctions>false</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem>Native</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MetalOSKind)' == 'Boot'">
    <ClCompile>
      <TreatWChar_tAsBuiltInType>false</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
    </ClCompile>
    <Link>
      <SubSystem>EFI Application</SubSystem>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MetalOSKind)' == 'User'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MetalOSSrc);$(MetalOSRoot)external;$(MetalOSSrc)User;$(MetalOSSrc)std</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Native</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MetalOSKind)' == 'User' and '$(ConfigurationType)' == 'Application'">
    <Link>
      <EntryPointSymbol>main</EntryPointSymbol>
    </Link>
  </ItemDefinitionGroup>

  <!-- The host unit tests are an ordinary Windows console program -->
  <ItemDefinitionGroup Condition="'$(MetalOSKind)' == 'Host'">
    <ClCompile>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
</Project>
