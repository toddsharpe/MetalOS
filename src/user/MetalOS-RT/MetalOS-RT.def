EXPORTS
	DllMain

	; Provided by runtime
	GetProcAddress
	GetProcessInfo
	GetCurrentThreadId
	GetLastError
	SetLastError
	DebugBreak
	DebugPrintf
	CDebugPrintf
	Bugcheck
	LoadLibrary
	FreeLibrary
	GetErrno

	; 0x100: System
	GetTickCount
	GetSystemTime

	; 0x200: Threads/Processes
	GetCurrentThread
	CreateProcess
	CreateThread
	GetThreadId
	Sleep
	SwitchToThread
	SuspendThread
	ResumeThread
	TerminateProcess
	ExitProcess
	TerminateThread
	ExitThread
	IsProcessAlive
	GetProcesses

	; 0x300: Devices (framebuffer export lives near memory; network interface enumeration)
	GetInterfaces

	; 0x400
	CreateFile
	ReadFile
	WriteFile
	SetFilePointer
	MoveFile
	DeleteFile
	CreateDirectory
	CreatePipe
	PeekNamedPipe
	CloseHandle

	; 0x500
	WaitForSingleObject
	CreateEvent
	SetEvent
	ResetEvent

	; 0x600
	VirtualAlloc
	VirtualFree
	CreateSharedMemory
	MapSharedMemory
	MapFramebuffer

	; 0x700
	DebugPrint
	DebugPrintBytes
	DebugPrintStack

	; 0x800: Network device (raw ethernet frame TX; the TCP/IP stack is in usermode netstack)
	NetSend

	; 0x900: IPC endpoints
	RegisterEndpoint
	LookupEndpoint
	PostEndpoint
	PollEndpoint

	; 0xA00: Handle capabilities
	ShareHandle
	ClaimHandle
