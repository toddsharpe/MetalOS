EXPORTS
	DllMain

	; Provided by runtime
	GetProcAddress
	GetProcessInfo
	GetCurrentThreadId
	GetLastError
	SetLastError
	DebugBreak
	DebugPrintf
	CDebugPrintf
	Bugcheck
	LoadLibrary
	FreeLibrary
	GetErrno

	; 0x100: System
	GetTickCount
	GetSystemTime

	; 0x200: Threads/Processes
	GetCurrentThread
	CreateProcess
	CreateThread
	GetThreadId
	Sleep
	SwitchToThread
	TerminateProcess
	ExitProcess
	TerminateThread
	ExitThread
	IsProcessAlive
	GetProcesses

	; 0x300: Devices (framebuffer, network interface enumeration, raw ethernet frame TX)
	MapFramebuffer
	GetInterfaces
	NetSend
	FlushFramebuffer

	; 0x400: Files/pipes
	CreateFile
	ReadFile
	WriteFile
	SetFilePointer
	MoveFile
	DeleteFile
	CreateDirectory
	CreatePipe
	PeekNamedPipe
	CloseHandle

	; 0x500: Synchronization
	WaitForSingleObject
	CreateEvent
	SetEvent
	ResetEvent

	; 0x600: Memory
	VirtualAlloc
	VirtualFree
	CreateSharedMemory
	MapSharedMemory
	DeleteSharedMemory

	; 0x700: Debug
	DebugPrint
	DebugPrintBytes
	DebugPrintStack

	; 0x900: IPC endpoints
	RegisterEndpoint
	LookupEndpoint
	PostEndpoint
	PollEndpoint

	; 0xA00: Handle capabilities
	ShareHandle
	ClaimHandle
